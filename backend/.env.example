DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=alalami_db
DB_USERNAME=postgres
DB_PASSWORD=

CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWKS_URL=

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
