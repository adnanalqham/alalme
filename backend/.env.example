APP_NAME=ALALAMI_API
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Riyadh

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
